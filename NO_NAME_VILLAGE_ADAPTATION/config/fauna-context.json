{
 "schema": "nnv-fauna-context-v1",
 "purpose": "Population contextuelle : biome + saison + heure + meteo decident QUI est present, avec quelle densite et quel comportement. Ce fichier n'ajoute aucune entite : il decrit les regles que NNVEcology applique aux entites deja injectees et a celles qui seront liberees plus tard.",
 "principle": "Les 1642 placements certifies ne sont JAMAIS remplaces. Les variantes s'ajoutent au systeme de vie ; elles ne le reecrivent pas.",

 "weather_states": {
  "clear":  {"desc": "temps degage", "activity": 1.0},
  "rain":   {"desc": "pluie", "activity": 0.75},
  "storm":  {"desc": "orage", "activity": 0.45},
  "snow":   {"desc": "neige", "activity": 0.7},
  "fog":    {"desc": "brouillard", "activity": 0.8}
 },

 "time_states": {
  "day":     {"desc": "journee"},
  "evening": {"desc": "crepuscule"},
  "night":   {"desc": "nuit"}
 },

 "rules": {
  "density_multiplier": "la densite d'une espece est multipliee par son facteur saison x heure x meteo ; 0 signifie absente",
  "never_spawn_in_obstacle": "toute apparition contextuelle repasse par les memes gardes de terrain que l'injection initiale",
  "no_vegetative": "une espece presente doit avoir un profil comportemental actif ou un etat d'immobilite nomme",
  "fail_closed": "sans preuve de terrain pour la saison concernee, l'espece reste HELD"
 },

