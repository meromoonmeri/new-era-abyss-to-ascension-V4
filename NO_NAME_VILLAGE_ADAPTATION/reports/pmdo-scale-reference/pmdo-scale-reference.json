  "q9_uniform_or_per_category": {
    "answer": "UNIFORM",
    "evidence": {
      "finding": "NNV internal proportions already match PMDO closely; only the unit differs",
      "house_over_terrain_cell": {
        "nnv": 14.8,
        "pmdo": 14.2
      },
      "rock_over_tree": {
        "nnv": 0.504,
        "pmdo": 0.5
      },
      "tree_over_house": {
        "nnv": 0.41,
        "pmdo": 0.423
      }
    },
    "reasoning": "NNV internal ratios (tree/house 0.410 vs 0.423, rock/tree 0.504 vs 0.500, house/cell 14.8 vs 14.2) already match PMDO. The world is internally consistent, so a single global factor suffices; per-category factors would break NNV's own proportions."
  },
  "read_only": true,
  "recommended_factor": 0.125,
  "recommended_factor_justification": "x0.125 is required by the PMDO scale law (64 px cell -> 8 px cell) and independently confirmed by object measurement (1.3-4.3% error). It is NOT selected for having the smallest mean error; it is the only factor that puts NNV into the PMDO measurement system. Cost: it exceeds NNV's art density of 4, so the second halving is lossy (~17% of bytes differ from the true /4 motif). That is a real, explicit trade-off requiring owner approval.",
  "rule": "PMDO = scale reference; NNV = world to normalise; PMU = assets integrated afterwards",
  "schema": "new-era.pmdo-scale-reference.v1"
}
