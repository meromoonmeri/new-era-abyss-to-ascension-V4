  "q1_pmdo_world_unit": {
    "law_verification": {
      "conforming_grounds": 423,
      "interpretation": "TexSize only chooses tileset granularity. The world unit is the 8 px collision cell in every map, and a Pokemon is always 16x16 px = 2x2 world units.",
      "law": "collision_grid == tile_grid * TexSize, and tile cell px == TexSize * 8",
