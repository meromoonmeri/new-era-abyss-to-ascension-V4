  "q4_texsize_role": {
    "conclusion": "TexSize does not change the world unit; it changes how much world a single tileset cell covers. NNV at TexSize 8 makes one tile cell span 4 Pokemon, where metano spans half a Pokemon.",
    "formula": "tile cell px = TexSize * 8",
    "metano": "TexSize 1 -> 8 px cell",
    "nnv": "TexSize 8 -> 64 px cell"
  },
