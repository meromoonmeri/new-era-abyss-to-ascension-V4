 int OFFSCREEN_GLES_LoadLibrary(_THIS, const char *path)
 {
-    int ret = SDL_EGL_LoadLibraryOnly(_this, path);
-    if (ret != 0) {
-        return ret;
+    int ret;
+    const char *angle_default = SDL_getenv("PMDO_HEADLESS_ANGLE_DEFAULT_DISPLAY");
+
+    if (angle_default && angle_default[0] == '1') {
+        /* Chromium's ANGLE exposes a surfaceless default display but not
+           EXT_device_enumeration.  Keep pbuffer config selection while using
+           that default display for the isolated PMDO validator only. */
+        ret = SDL_EGL_LoadLibrary(_this, path, EGL_DEFAULT_DISPLAY, 0);
+        if (ret == 0) {
+            _this->egl_data->is_offscreen = SDL_TRUE;
+        }
+    } else {
+        ret = SDL_EGL_LoadLibraryOnly(_this, path);
+        if (ret == 0) {
+            /* driver_loaded gets incremented by SDL_GL_LoadLibrary when we
+               return, but InitializeOffscreen checks it before then. */
+            _this->gl_config.driver_loaded++;
+            ret = SDL_EGL_InitializeOffscreen(_this, 0);
+            _this->gl_config.driver_loaded--;
+        }
     }
-
-    /* driver_loaded gets incremented by SDL_GL_LoadLibrary when we return,
-       but SDL_EGL_InitializeOffscreen checks that we're loaded before then,
-       so temporarily bump it since we know that LoadLibraryOnly succeeded. */
-
-    _this->gl_config.driver_loaded++;
-    ret = SDL_EGL_InitializeOffscreen(_this, 0);
-    _this->gl_config.driver_loaded--;
     if (ret != 0) {
         return ret;
