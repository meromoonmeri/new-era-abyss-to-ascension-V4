{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-era.invalid/bibliotheque/provenance.schema.json",
  "title": "BIBLIOTHEQUE provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "commit", "source_path", "sha256", "size_bytes", "extraction_method"],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "source_format": {"type": "string"},
    "extraction_method": {"type": "string", "minLength": 1},
    "license_status": {"enum": ["UNKNOWN", "DOCUMENTED", "RESTRICTED", "PERMITTED"]}
  }
}
