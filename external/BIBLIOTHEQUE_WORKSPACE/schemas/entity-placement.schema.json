{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-era.invalid/bibliotheque/entity-placement.schema.json",
  "title": "Redacted source entity placement",
  "type": "object",
  "additionalProperties": false,
  "required": ["placeholder_id", "source_event_id", "page_index", "classification", "position", "graphic", "movement", "collision", "trigger", "condition_flags", "visual_commands"],
  "properties": {
    "placeholder_id": {"type": "string", "pattern": "^map_[0-9]{3}_entity_[0-9]{4}_page_[0-9]{2}$"},
    "source_event_id": {"type": "integer", "minimum": 1},
    "page_index": {"type": "integer", "minimum": 0},
    "classification": {"enum": ["CAST_PLACEHOLDER", "ENVIRONMENTAL_TILE_ENTITY", "LOGIC_MARKER"]},
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}}
    },
    "graphic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_identity_redacted", "source_identity_sha256", "tile_id", "direction", "pattern", "opacity", "blend_type"],
      "properties": {
        "source_identity_redacted": {"const": true},
        "source_identity_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "tile_id": {"type": "integer", "minimum": 0},
        "direction": {"type": "integer"},
        "pattern": {"type": "integer"},
        "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
        "blend_type": {"type": "integer"}
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "speed", "frequency", "walk_animation", "step_animation", "direction_fix", "route_repeat", "route_skippable", "route_commands"],
      "properties": {
        "type": {"type": "integer"},
        "speed": {"type": "integer"},
        "frequency": {"type": "integer"},
        "walk_animation": {"type": "boolean"},
        "step_animation": {"type": "boolean"},
        "direction_fix": {"type": "boolean"},
        "route_repeat": {"type": "boolean"},
        "route_skippable": {"type": "boolean"},
        "route_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "safe_parameters", "redacted_parameter_count"],
            "properties": {
              "code": {"type": "integer"},
              "safe_parameters": {"type": "array", "items": {"type": ["integer", "number", "boolean", "null"]}},
              "redacted_parameter_count": {"type": "integer", "minimum": 0},
              "redacted_parameter_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["through", "always_on_top", "dynamic"],
      "properties": {
        "through": {"type": "boolean"},
        "always_on_top": {"type": "boolean"},
        "dynamic": {"const": true}
      }
    },
    "trigger": {"type": "integer"},
    "condition_flags": {"type": "object"},
    "visual_commands": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "excluded_command_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  }
}
