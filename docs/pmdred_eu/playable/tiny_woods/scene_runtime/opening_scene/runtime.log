[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":28,"pointer":"0x084CD998","speaker":"partner","text":"Qu'y a-t-il?","detail":"","music":""}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":28,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"choreography","scene":"d01p01_g1","sequence":0,"pointer":"","speaker":"","text":"","detail":"trouble_music","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":29,"pointer":"0x084CD818","speaker":"butterfree","text":"C'est horrible!\nMon Chenipan est tombé dans une\ngrotte! Mon pauvre bébé!","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":29,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":30,"pointer":"0x084CD7EC","speaker":"partner","text":"Quoi???","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":30,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":31,"pointer":"0x084CD680","speaker":"butterfree","text":"Une énorme fissure s'est\nouverte dans le sol et mon Chenipan\nest tombé dedans!","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":31,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":32,"pointer":"0x084CD58C","speaker":"butterfree","text":"Il est trop jeune pour en\nsortir tout seul!","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":32,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":33,"pointer":"0x084CD424","speaker":"butterfree","text":"Et lorsque j'ai essayé de\nl'aider, des Pokémon m'ont attaquée!","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":33,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":34,"pointer":"0x084CD318","speaker":"partner","text":"Hein? Vous avez été\nattaquée?[pause=30]\nPar d'autres Pokémon?","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":34,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":35,"pointer":"0x084CD15C","speaker":"butterfree","text":"Peut-être qu'ils sont en\ncolère à cause de la fissure... En tout cas,\nils sont fous furieux!","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":35,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":36,"pointer":"0x084CCF88","speaker":"butterfree","text":"Je ne suis pas assez forte\npour affronter ces Pokémon sauvages...[pause=30]\nQue va-t-il advenir de mon bébé?","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":36,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":37,"pointer":"0x084CCE94","speaker":"butterfree","text":"Oh! Que dois-je faire???\nJe ne sais plus où j'en suis...","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":37,"menu_count":1}
[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":38,"pointer":"0x084CCC60","speaker":"partner","text":"Ça a l'air grave!\nNous devons les aider!","detail":"","music":"PMD Red - There's Trouble.ogg"}
[TINY_WOODS_SCENES] {"event":"dialogue_menu_closed","number":38,"menu_count":1}
