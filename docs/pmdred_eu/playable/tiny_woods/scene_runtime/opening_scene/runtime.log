[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":24,"pointer":"0x084CDE20","speaker":"partner","text":"Oh.\n[color=#009CFF]BIG_AF_NAME[color] est ton nom?\n[color=#009CFF]BIG_AF_NAME[color]?[pause=30] Eh bien...","detail":"","music":"PMD Red - Heartwarming.ogg"}
