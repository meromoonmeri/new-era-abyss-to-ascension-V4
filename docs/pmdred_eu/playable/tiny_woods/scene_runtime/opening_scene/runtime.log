[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":26,"pointer":"0x084CDBD8","speaker":"butterfree","text":"S'il vous plaît! A l'aide!","detail":"","music":""}
