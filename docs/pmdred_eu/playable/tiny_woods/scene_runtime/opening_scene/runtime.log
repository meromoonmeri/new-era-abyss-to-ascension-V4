[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":27,"pointer":"0x084CDA4C","speaker":"partner","text":"Hein? J'ai entendu crier par\nlà...","detail":"","music":""}
