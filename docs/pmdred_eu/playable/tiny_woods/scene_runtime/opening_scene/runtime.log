[TINY_WOODS_SCENES] {"event":"scene_trace","kind":"dialogue","scene":"d01p01_g1","sequence":15,"pointer":"0x084CEB24","speaker":"partner","text":"Et tu es?[pause=30]\nC'est la première fois que je te vois.","detail":"","music":"PMD Red - Heartwarming.ogg"}
